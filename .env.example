# Web search (Tavily is the default; Brave is optional)
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# LLM drafting (Groq is the default; OpenAI is optional)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Sender identity
SENDER_NAME=
SENDER_BUSINESS=
SENDER_EMAIL=
SENDER_POSTAL_ADDRESS=

# Optional outgoing email (SMTP over SSL)
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
